{
	"name": "@cioudguy/tidaluna-plugins",
	"description": "Plugins for TidaLuna",
	"author": {
		"name": "CIoudGuy",
		"url": "https://github.com/CIoudGuy"
	},
	"homepage": "https://github.com/CIoudGuy/TidaLuna-Plugins",
	"type": "module",
	"scripts": {
		"watch": "concurrently \"pnpm:build --watch\" pnpm:serve",
		"build": "rimraf ./dist && tsx esbuild.config.ts",
		"serve": "http-server ./dist -p 3000 -s --cors -c-1",
		"typecheck": "tsc --noEmit -p . 2>&1 | grep -E '^plugins/' && exit 1 || exit 0"
	},
	"devDependencies": {
		"@types/node": "^25.0.9",
		"@types/react": "^19.2.8",
		"@types/react-dom": "^19.2.3",
		"concurrently": "^9.2.1",
		"http-server": "^14.1.1",
		"luna": "github:Inrixia/TidaLuna",
		"oby": "^15.1.2",
		"rimraf": "^6.1.2",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3"
	}
}
